<header class="nav">
  <a class="nav__logo" href="/">anidiary</a>
  <nav class="nav__seasons" aria-label="<%= ui.season %>">
    <a class="nav__step nav__step--prev" rel="prev" href="/season/<%= adjacentSeasons.prevYear %>/<%= adjacentSeasons.prevSeason %>"><span class="nav__step-label"><%= ui.seasons[adjacentSeasons.prevSeason] %> <%= adjacentSeasons.prevYear %></span></a>
    <h1 class="nav__season"><%= ui.seasons[season] %> <%= year %></h1>
    <a class="nav__step nav__step--next" rel="next" href="/season/<%= adjacentSeasons.nextYear %>/<%= adjacentSeasons.nextSeason %>"><span class="nav__step-label"><%= ui.seasons[adjacentSeasons.nextSeason] %> <%= adjacentSeasons.nextYear %></span></a>
  </nav>
  <div class="nav__right">
    <div class="lang-toggle" role="group" aria-label="<%= ui.language %>">
      <% for (const [code, label] of [['en', 'EN'], ['jp', 'JP'], ['ru', 'RU']]) { %>
        <button type="button" data-lang="<%= code %>" aria-pressed="<%= user.langPref === code ? 'true' : 'false' %>"><%= label %></button>
      <% } %>
    </div>
    <details class="account-menu">
      <summary class="nav__user" aria-label="<%= ui.account %>: <%= user.username %>"><span class="nav__avatar" aria-hidden="true"><%= String(user.username || '?').charAt(0).toUpperCase() %></span><span class="nav__username"><%= user.username %></span></summary>
      <div class="account-menu__panel">
        <form method="POST" action="/logout" class="logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="logout-btn"><%= ui.logout %></button>
        </form>
      </div>
    </details>
  </div>
</header>
