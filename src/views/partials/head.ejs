<head>
  <% const assetUrl = typeof asset === 'function' ? asset : (url) => url; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FAFCFF">
  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <% if (typeof refresh !== 'undefined' && refresh) { %>
    <meta http-equiv="refresh" content="<%= refresh.seconds %>;url=<%= refresh.url %>">
  <% } %>
  <title><%= title ? title + ' - anidiary' : 'anidiary' %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="preload" href="<%= assetUrl('/fonts/onest.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%= assetUrl('/fonts/unbounded.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= assetUrl('/css/style.css') %>">
</head>
