<%
  const isRussian = user.langPref === 'ru';
  const seasonNames = isRussian
    ? { winter: 'Зима', spring: 'Весна', summer: 'Лето', fall: 'Осень' }
    : { winter: 'Winter', spring: 'Spring', summer: 'Summer', fall: 'Fall' };
  const ui = isRussian ? {
    season: 'Сезон',
    language: 'Язык',
    logout: 'Выйти',
    all: 'Все',
    following: 'Мои',
    sortBy: 'Сортировка:',
    malScore: 'Оценка MAL',
    anilistScore: 'Оценка AniList',
    shikimoriScore: 'Оценка Shikimori',
    nextEpisode: 'Следующая серия',
    title: 'Название',
    close: 'Закрыть',
    follow: 'Отслеживать',
    jellyfin: 'Jellyfin',
    watched: 'Просмотрено',
    released: 'Вышло',
    notAired: 'Не вышло',
    tba: 'Неизвестно',
    episodeShort: 'сер.',
    showMore: 'Подробнее'
  } : {
    season: 'Season',
    language: 'Language',
    logout: 'Logout',
    all: 'All',
    following: 'Following',
    sortBy: 'Sort by:',
    malScore: 'MAL Score',
    anilistScore: 'AniList Score',
    shikimoriScore: 'Shikimori Score',
    nextEpisode: 'Next Episode',
    title: 'Title',
    close: 'Close',
    follow: 'Follow',
    jellyfin: 'Jellyfin',
    watched: 'Watched',
    released: 'Released',
    notAired: 'Not aired',
    tba: 'TBA',
    episodeShort: 'ep',
    showMore: 'Show more'
  };
%>
<!DOCTYPE html>
<html lang="<%= isRussian ? 'ru' : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= seasonNames[season] %> <%= year %> - anidiary</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="nav">
    <a class="nav__logo" href="/">anidiary</a>
    <div class="nav__season-picker">
      <a class="nav__season-link" href="/season/<%= adjacentSeasons.prevYear %>/<%= adjacentSeasons.prevSeason %>">
        ← <%= seasonNames[adjacentSeasons.prevSeason] %> <%= adjacentSeasons.prevYear %>
      </a>
      <span class="nav__current">
        <%= seasonNames[season] %> <%= year %>
      </span>
      <a class="nav__season-link" href="/season/<%= adjacentSeasons.nextYear %>/<%= adjacentSeasons.nextSeason %>">
        <%= seasonNames[adjacentSeasons.nextSeason] %> <%= adjacentSeasons.nextYear %> →
      </a>
      <label class="visually-hidden" for="season-select"><%= ui.season %></label>
      <select class="nav-select season-select" id="season-select">
        <option value="/season/<%= adjacentSeasons.prevYear %>/<%= adjacentSeasons.prevSeason %>">
          <%= seasonNames[adjacentSeasons.prevSeason] %> '<%= String(adjacentSeasons.prevYear).slice(-2) %>
        </option>
        <option value="/season/<%= year %>/<%= season %>" selected>
          <%= seasonNames[season] %> '<%= String(year).slice(-2) %>
        </option>
        <option value="/season/<%= adjacentSeasons.nextYear %>/<%= adjacentSeasons.nextSeason %>">
          <%= seasonNames[adjacentSeasons.nextSeason] %> '<%= String(adjacentSeasons.nextYear).slice(-2) %>
        </option>
      </select>
    </div>
    <div class="nav__right">
      <div class="lang-toggle">
        <button data-lang="en" class="<%= user.langPref === 'en' ? 'active' : '' %>">EN</button>
        <button data-lang="jp" class="<%= user.langPref === 'jp' ? 'active' : '' %>">JP</button>
        <button data-lang="ru" class="<%= user.langPref === 'ru' ? 'active' : '' %>">RU</button>
      </div>
      <label class="visually-hidden" for="language-select"><%= ui.language %></label>
      <select class="nav-select language-select" id="language-select">
        <option value="en" <%= user.langPref === 'en' ? 'selected' : '' %>>EN</option>
        <option value="jp" <%= user.langPref === 'jp' ? 'selected' : '' %>>JP</option>
        <option value="ru" <%= user.langPref === 'ru' ? 'selected' : '' %>>RU</option>
      </select>
      <details class="account-menu">
        <summary class="nav__user"><%= user.username %></summary>
        <div class="account-menu__panel">
          <form method="POST" action="/logout" class="logout-form">
            <button type="submit" class="logout-btn"><%= ui.logout %></button>
          </form>
        </div>
      </details>
    </div>
  </nav>

  <main class="main">
    <div class="controls">
      <div class="controls__tabs">
        <button class="tab active" data-tab="all"><%= ui.all %> (<%= animeList.length %>)</button>
        <button class="tab" data-tab="following"><%= ui.following %> (<%= [...userStatuses.values()].filter(s => s).length %>)</button>
      </div>
      <div class="controls__sort">
        <label><%= ui.sortBy %></label>
        <select id="sort-select">
          <option value="score_mal"><%= ui.malScore %></option>
          <option value="score_anilist"><%= ui.anilistScore %></option>
          <option value="score_shiki"><%= ui.shikimoriScore %></option>
          <option value="next_ep"><%= ui.nextEpisode %></option>
          <option value="title"><%= ui.title %></option>
        </select>
      </div>
    </div>

    <div class="card-grid">
      <% for (const anime of animeList) { %>
        <%- include('partials/card', { anime, userStatus: userStatuses.get(anime.mal_id), langPref: user.langPref, ui, isCurrentSeason: true, initiallyHidden: false }) %>
      <% } %>
      <% for (const anime of followedAnimeOutsideSeason) { %>
        <%- include('partials/card', { anime, userStatus: userStatuses.get(anime.mal_id), langPref: user.langPref, ui, isCurrentSeason: false, initiallyHidden: true }) %>
      <% } %>
    </div>
  </main>

  <!-- Detail Modal -->
  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal" id="animeModal" role="dialog" aria-modal="true">
      <div class="modal__header">
        <img class="modal__poster" id="modalPoster" src="" alt="">
        <div class="modal__info">
          <h2 class="modal__title" id="modalTitle"></h2>
          <div class="modal__titles">
            <span class="modal__title-jp" id="modalTitleJp"></span>
            <span class="modal__title-ru" id="modalTitleRu"></span>
          </div>
          <div class="modal__badges">
            <div class="modal__countdown" id="modalCountdown"></div>
            <span class="modal__status" id="modalStatus"></span>
            <span class="modal__episodes" id="modalEpisodes"></span>
          </div>
        </div>
        <button class="modal__close" id="modalClose" aria-label="<%= ui.close %>">&times;</button>
      </div>
      <div class="modal__body">
        <div id="modalSynopsisEn" class="modal__synopsis modal__synopsis-en"></div>
        <div id="modalSynopsisRu" class="modal__synopsis modal__synopsis-ru"></div>
        <div id="modalGenres" class="modal__genres"></div>
        <div class="modal__scores" id="modalScores"></div>
        <div id="modalRelated" class="modal__related"></div>
      </div>
      <div class="modal__footer">
        <div class="modal__series-nav" id="modalSeriesNav" hidden>
          <button class="btn modal__series-btn" id="modalPrevSeries" type="button" hidden>
            <span class="modal__series-label"></span>
            <span class="modal__series-title"></span>
            <span class="modal__series-meta"></span>
          </button>
          <button class="btn modal__series-btn" id="modalNextSeries" type="button" hidden>
            <span class="modal__series-label"></span>
            <span class="modal__series-title"></span>
            <span class="modal__series-meta"></span>
          </button>
        </div>
        <div class="modal__actions" id="modalActions">
          <button class="btn btn--follow" type="button" data-status="following">♡ <%= ui.follow %></button>
          <button class="btn btn--jellyfin" type="button" data-status="in_jellyfin">📦 <%= ui.jellyfin %></button>
          <button class="btn btn--watched" type="button" data-status="watched">✓ <%= ui.watched %></button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
