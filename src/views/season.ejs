<!DOCTYPE html>
<html lang="<%= ui.code %>">
<%- include('partials/head', { title: ui.seasons[season] + ' ' + year, csrfToken, refresh: typeof refresh !== 'undefined' ? refresh : null }) %>
<body class="season-page" data-lang="<%= user.langPref %>">
  <%- include('partials/navigation', { ui, user, year, season, adjacentSeasons, csrfToken }) %>

  <main class="main">
    <% const pageSeedState = typeof seedState !== 'undefined' ? seedState : null; %>
    <% if (pageSeedState === 'pending') { %>
      <p class="season-state season-state--pending" role="status"><%= ui.seasonFetching %></p>
    <% } else if (pageSeedState === 'failed') { %>
      <div class="season-state season-state--failed" role="status">
        <p>
          <%= ui.seasonFetchFailed %>
          <% if (typeof retryInMinutes !== 'undefined' && retryInMinutes) { %>
            <time datetime="<%= retryAtIso %>"><%= ui.seasonRetryIn.replace('{minutes}', retryInMinutes) %></time>
          <% } %>
        </p>
        <form method="POST" action="/season/<%= year %>/<%= season %>/retry">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn--primary"><%= ui.retry %></button>
        </form>
      </div>
    <% } else if (pageSeedState === 'empty') { %>
      <p class="season-state" role="status"><%= ui.seasonEmpty %></p>
    <% } %>

    <section class="week" id="week" aria-labelledby="weekHeading">
      <h2 class="vh" id="weekHeading"><%= ui.week %></h2>
      <ol class="week__days" id="weekDays" hidden></ol>
      <p class="week__empty" id="weekEmpty" hidden></p>
    </section>

    <% const statusCount = (wanted) => [...userStatuses.values()].filter((value) => value === wanted).length; %>
    <div class="controls">
      <div class="tabs" role="group" aria-label="<%= ui.titleLists %>">
        <button class="tab" type="button" data-tab="all" aria-pressed="true"><%= ui.all %> <span class="tab__count"><%= animeList.length %></span></button>
        <button class="tab" type="button" data-tab="following" aria-pressed="false"><%= ui.following %> <span class="tab__count"><%= statusCount('following') %></span></button>
        <button class="tab" type="button" data-tab="watching" aria-pressed="false"><%= ui.watching %> <span class="tab__count"><%= statusCount('watching') %></span></button>
      </div>
      <div class="filters">
        <label class="search">
          <span class="vh"><%= ui.search %></span>
          <input type="search" id="title-search" placeholder="<%= ui.search %>" autocomplete="off" spellcheck="false">
        </label>
        <label class="field">
          <span class="vh"><%= ui.format %></span>
          <select id="format-filter">
            <option value="all" selected><%= ui.formatAll %></option>
            <option value="tv"><%= ui.formatTv %></option>
            <option value="movie"><%= ui.formatMovie %></option>
            <option value="other"><%= ui.formatOther %></option>
          </select>
        </label>
        <label class="toggle">
          <input type="checkbox" id="hide-watched">
          <span><%= ui.hideWatched %></span>
        </label>
        <label class="field field--sort">
          <span class="field__label"><%= ui.sortBy %></span>
          <select id="sort-select">
            <option value="popularity" selected><%= ui.popularity %></option>
            <option value="score_mal"><%= ui.malScore %></option>
            <option value="score_anilist"><%= ui.anilistScore %></option>
            <option value="score_shiki"><%= ui.shikimoriScore %></option>
            <option value="next_ep"><%= ui.nextEpisode %></option>
            <option value="title"><%= ui.title %></option>
          </select>
        </label>
      </div>
    </div>

    <ul class="catalogue" id="catalogue">
      <% animeList.forEach((anime, index) => { %>
        <%- include('partials/title', { anime, userStatus: userStatuses.get(anime.mal_id), partners: partnerStatuses.get(anime.mal_id), langPref: user.langPref, ui, inSeason: true, eager: index < 8, nowSeconds, titleItem }) %>
      <% }) %>
      <% for (const anime of trackedAnimeOutsideSeason) { %>
        <%- include('partials/title', { anime, userStatus: userStatuses.get(anime.mal_id), partners: partnerStatuses.get(anime.mal_id), langPref: user.langPref, ui, inSeason: false, eager: false, nowSeconds, titleItem }) %>
      <% } %>
    </ul>
    <p class="catalogue__empty" id="noMatch" role="status" hidden><%= ui.noMatch %></p>
  </main>

  <dialog class="detail" id="animeModal" aria-labelledby="modalTitle" aria-busy="false">
    <div class="detail__sheet">
      <button class="detail__close" id="modalClose" type="button" aria-label="<%= ui.close %>"></button>
      <div class="detail__head">
        <img class="detail__poster" id="modalPoster" alt="" width="200" height="300">
        <div class="detail__info">
          <h2 class="detail__title" id="modalTitle" tabindex="-1"></h2>
          <p class="detail__alt"><span id="modalTitleJp" lang="ja"></span><span id="modalTitleRu" lang="ru"></span></p>
          <p class="detail__when"><span id="modalCountdown"></span><span id="modalEpisodes"></span><span class="detail__airing" id="modalStatus"></span></p>
          <p class="detail__partners" id="modalPartners" hidden></p>
        </div>
        <div class="detail__acts" id="modalActions">
          <span class="seg seg--labelled" role="group" aria-label="<%= ui.yourStatus %>">
            <button type="button" data-set="following" aria-pressed="false"><%= ui.follow %></button>
            <button type="button" data-set="watching" aria-pressed="false"><%= ui.watching %></button>
            <button type="button" data-set="watched" aria-pressed="false"><%= ui.watched %></button>
          </span>
          <button type="button" class="jf" data-set="jellyfin" aria-pressed="false"><%= ui.inJellyfin %></button>
        </div>
      </div>
      <div class="detail__body">
        <p class="detail__state" id="modalState" role="status" aria-live="polite"></p>
        <p id="modalSynopsisEn" class="detail__synopsis" lang="en"></p>
        <p id="modalSynopsisRu" class="detail__synopsis" lang="ru"></p>
        <ul id="modalGenres" class="detail__genres" aria-label="<%= ui.genres %>"></ul>
        <p class="detail__scores" id="modalScores"></p>
        <div id="modalRelated" class="detail__related"></div>
        <div class="detail__series" id="modalSeriesNav" hidden>
          <button class="detail__series-btn" id="modalPrevSeries" type="button" hidden>
            <span class="detail__series-label"></span>
            <span class="detail__series-title"></span>
            <span class="detail__series-meta"></span>
          </button>
          <button class="detail__series-btn detail__series-btn--next" id="modalNextSeries" type="button" hidden>
            <span class="detail__series-label"></span>
            <span class="detail__series-title"></span>
            <span class="detail__series-meta"></span>
          </button>
        </div>
      </div>
    </div>
  </dialog>

  <%- include('partials/app-scripts', { localeJson }) %>
</body>
</html>
