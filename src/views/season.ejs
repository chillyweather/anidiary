<!DOCTYPE html>
<html lang="<%= ui.code %>">
<%- include('partials/head', { title: ui.seasons[season] + ' ' + year, csrfToken }) %>
<body>
  <%- include('partials/navigation', { ui, user, year, season, adjacentSeasons, csrfToken }) %>

  <main class="main">
    <div class="controls">
      <div class="controls__tabs">
        <button class="tab active" data-tab="all"><%= ui.all %> (<%= animeList.length %>)</button>
        <button class="tab" data-tab="following"><%= ui.following %> (<%= [...userStatuses.values()].filter(s => s).length %>)</button>
      </div>
      <div class="controls__sort">
        <label><%= ui.sortBy %></label>
        <select id="sort-select">
          <option value="score_mal"><%= ui.malScore %></option>
          <option value="score_anilist"><%= ui.anilistScore %></option>
          <option value="score_shiki"><%= ui.shikimoriScore %></option>
          <option value="next_ep"><%= ui.nextEpisode %></option>
          <option value="title"><%= ui.title %></option>
        </select>
      </div>
    </div>

    <div class="card-grid">
      <% for (const anime of animeList) { %>
        <%- include('partials/card', { anime, userStatus: userStatuses.get(anime.mal_id), langPref: user.langPref, ui, isCurrentSeason: true, initiallyHidden: false }) %>
      <% } %>
      <% for (const anime of followedAnimeOutsideSeason) { %>
        <%- include('partials/card', { anime, userStatus: userStatuses.get(anime.mal_id), langPref: user.langPref, ui, isCurrentSeason: false, initiallyHidden: true }) %>
      <% } %>
    </div>
  </main>

  <!-- Detail Modal -->
  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal" id="animeModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" tabindex="-1" aria-busy="false">
      <div class="modal__header">
        <img class="modal__poster" id="modalPoster" src="" alt="">
        <div class="modal__info">
          <h2 class="modal__title" id="modalTitle"></h2>
          <div class="modal__titles">
            <span class="modal__title-jp" id="modalTitleJp"></span>
            <span class="modal__title-ru" id="modalTitleRu"></span>
          </div>
          <div class="modal__badges">
            <div class="modal__countdown" id="modalCountdown"></div>
            <span class="modal__status" id="modalStatus"></span>
            <span class="modal__episodes" id="modalEpisodes"></span>
          </div>
        </div>
        <button class="modal__close" id="modalClose" aria-label="<%= ui.close %>">&times;</button>
      </div>
      <div class="modal__body">
        <div class="modal__state" id="modalState" role="status" aria-live="polite"></div>
        <div id="modalSynopsisEn" class="modal__synopsis modal__synopsis-en"></div>
        <div id="modalSynopsisRu" class="modal__synopsis modal__synopsis-ru"></div>
        <div id="modalGenres" class="modal__genres"></div>
        <div class="modal__scores" id="modalScores"></div>
        <div id="modalRelated" class="modal__related"></div>
      </div>
      <div class="modal__footer">
        <div class="modal__series-nav" id="modalSeriesNav" hidden>
          <button class="btn modal__series-btn" id="modalPrevSeries" type="button" hidden>
            <span class="modal__series-label"></span>
            <span class="modal__series-title"></span>
            <span class="modal__series-meta"></span>
          </button>
          <button class="btn modal__series-btn" id="modalNextSeries" type="button" hidden>
            <span class="modal__series-label"></span>
            <span class="modal__series-title"></span>
            <span class="modal__series-meta"></span>
          </button>
        </div>
        <div class="modal__actions" id="modalActions">
          <button class="btn btn--follow" type="button" data-status="following">♡ <%= ui.follow %></button>
          <button class="btn btn--jellyfin" type="button" data-jellyfin="true">📦 <%= ui.jellyfin %></button>
          <button class="btn btn--watched" type="button" data-status="watched">✓ <%= ui.watched %></button>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/app-scripts', { localeJson }) %>
</body>
</html>
