<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Log in' }) %>
<body class="auth-page">
  <main class="auth">
    <img class="auth__mascot" src="/img/mascot.webp" width="214" height="256" alt="">
    <div class="auth-card">
      <p class="auth-card__band">anidiary</p>
      <div class="auth-card__body">
        <h1 class="auth-card__title">Log in</h1>
        <p class="auth-card__subtitle">See this season's anime and when your shows air next.</p>

        <% if (error) { %>
        <p class="auth-card__error" role="alert"><%= error %></p>
        <% } %>

        <form class="auth-card__form" method="POST" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" autocomplete="username" autocapitalize="none" required autofocus>
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
          </div>
          <button type="submit" class="btn btn--primary btn--full">Log in</button>
        </form>

        <p class="auth-card__link">No account yet? <a href="/register">Create an account</a></p>
      </div>
    </div>
  </main>
</body>
</html>
